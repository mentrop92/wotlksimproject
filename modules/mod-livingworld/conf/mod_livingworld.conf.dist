[worldserver]

# Enable the LivingWorld module at server startup.
# This is the static master switch. Runtime pause/resume state is stored in the
# character database and controlled with .livingworld commands.
# Default: 1
LivingWorld.Enable = 1

# Initial runtime state used only when no persisted world settings row exists.
# Default: 1
LivingWorld.RuntimeEnabled = 1
LivingWorld.LoginEnabled = 1

# Create profiles for real human-controlled characters as well as Playerbots.
# Keep disabled for the production simulation so only AI citizens receive profiles.
# Default: 0
LivingWorld.ProfileHumans = 0

# How often an online character is checked for Playerbot registration and a
# persistent LivingWorld profile. A delay is intentional because Playerbot AI
# registration may complete after the normal player login hook.
# Default: 5000
LivingWorld.ProfileCheckIntervalMs = 5000

# Stop checking a normal login for delayed Playerbot registration after this
# many milliseconds. This prevents human characters from being checked forever.
# Default: 60000
LivingWorld.ProfileDetectionTimeoutMs = 60000

# Initial online population policy used only when no persisted settings row exists.
# The tolerance creates a no-action band around the target so small fluctuations
# do not cause constant login/logout churn.
LivingWorld.Population.MinimumOnline = 50
LivingWorld.Population.MaximumOnline = 500
LivingWorld.Population.TargetOnline = 250
LivingWorld.Population.Tolerance = 15
LivingWorld.Population.AutoScale = 1
LivingWorld.Population.LoginRatePerMinute = 15
LivingWorld.Population.LogoutRatePerMinute = 20

# Let the population controller steer Playerbots' random-bot population.
# 0 = dry run: decisions are planned, logged, and visible in .livingworld
#     population, but no bot is logged in or out.
# 1 = execute: LivingWorld sets RandomPlayerbotMgr's bot_count target and
#     clears the "add" event of selected bots so Playerbots logs them out
#     through its own checks. Requires AiPlayerbot.RandomBotAutologin = 1.
#     Targets are clamped to AiPlayerbot.MinRandomBots/MaxRandomBots, so set
#     those to bracket LivingWorld's minimum and maximum online population.
# Default: 0
LivingWorld.Population.Execute = 0

# Maximum number of non-protected short-term memories retained per bot.
# Memory pruning will be implemented after the identity foundation is stable.
# Default: 50
LivingWorld.MemoryLimit = 50
